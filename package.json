{
  "name": "sveld",
  "version": "0.41.1",
  "description": "Generate TypeScript definitions and component documentation for your Svelte components.",
  "license": "Apache-2.0",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": "github:carbon-design-system/sveld",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schema/component-api.schema.json": "./schema/component-api.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "sveld": "dist/cli.js"
  },
  "keywords": [
    "svelte",
    "svelte component",
    "documentation",
    "docgen",
    "typescript",
    "definitions",
    "JSDocs",
    "vite",
    "vite-plugin"
  ],
  "scripts": {
    "test": "bun test --parallel",
    "test:changed": "bivium run --suite unit",
    "test:update": "SVELD_UPDATE_FIXTURES=1 bun test tests/fixtures.test.ts",
    "test:fixtures-types": "bun check --project tsconfig.fixtures.json",
    "test:types-matrix": "bun scripts/typecheck-option-matrix.ts",
    "test:svelte-versions": "bun scripts/typecheck-svelte-versions.ts",
    "test:e2e": "bun tests/test-e2e.ts",
    "test:inferred-types": "bun scripts/check-inferred-types.ts",
    "lint:all": "bun fmt && bun lint --fix && svelte-lint --fix",
    "lint:changed": "bun fmt --changed && bun lint --changed --fix && svelte-lint --changed --fix",
    "lint:svelte": "svelte-lint",
    "knip": "knip-bun",
    "build": "bun scripts/build.ts",
    "bench": "bun scripts/bench.ts",
    "bench:cache": "bun scripts/bench.ts --cache",
    "bench:ostia": "ostia bench scripts/bench-ostia.ts",
    "typecheck": "bun check && bun check --project tsconfig.excluded.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/typescript6": "^6.0.2",
    "ajv": "^8.20.0",
    "bivium": "^0.6.0",
    "knip": "^6.47.0",
    "ostia": "^0.2.12",
    "svelte": "^5.59.1",
    "svelte-ast": "^0.12.1",
    "svelte-lint": "^0.2.0",
    "typescript": "^7.0.2"
  }
}
